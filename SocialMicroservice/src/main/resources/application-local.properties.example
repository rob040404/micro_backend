### Example to build your properties ###
app.security.blot.apikey=${KEY1}
app.users.users.apikey=${KEY2}

spring.datasource.url=jdbc:mysql://host/db
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}

# === Kafka general ===
#Server and port of Kafka
spring.kafka.bootstrap-servers=${SERVERS}

# Spring creates the topics automatically if we do not do it
spring.kafka.admin.auto-create=true


# === Topic (from ENV) ===
topic.follow-requests=${TOPIC1}
topic.follow-answers=${TOPIC2}

# It reduces the logs of Kafka to the minimum (erors)
logging.level.org.apache.kafka=ERROR
logging.level.org.springframework.kafka=ERROR